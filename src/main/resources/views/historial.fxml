<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stockwise.controller.HistorialController" styleClass="page">
    <VBox spacing="2">
        <Label text="Historial de datos y análisis" styleClass="page-title"/>
        <Label styleClass="page-subtitle" wrapText="true"
               text="Archivos importados y análisis realizados en este proyecto. Eliminar un análisis nunca borra las ventas, compras ni inventario: el historial se conserva para las próximas predicciones."/>
    </VBox>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Importaciones">
            <VBox spacing="8">
                <HBox styleClass="toolbar-row">
                    <Label fx:id="importsInfo" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Importar archivo" onAction="#importFile"/>
                    <Button fx:id="rejectedButton" text="Descargar filas rechazadas" onAction="#downloadRejected"/>
                    <Button fx:id="deleteImportButton" text="Eliminar importación" styleClass="danger"
                            onAction="#deleteImport"/>
                </HBox>
                <TableView fx:id="importsTable" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
        <Tab text="Análisis realizados">
            <VBox spacing="8">
                <HBox styleClass="toolbar-row">
                    <Label fx:id="analysisInfo" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Region/>
                    <Button fx:id="openButton" text="Ver resultados" onAction="#openAnalysis"/>
                    <Button fx:id="deleteAnalysisButton" text="Eliminar resultados" styleClass="danger"
                            onAction="#deleteAnalysis"/>
                    <Button text="Analizar ahora" styleClass="primary" onAction="#analyze"/>
                </HBox>
                <TableView fx:id="analysisTable" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
