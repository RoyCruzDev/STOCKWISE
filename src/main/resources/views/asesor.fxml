<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stockwise.controller.AsesorController" styleClass="page">
    <HBox styleClass="toolbar-row">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Asesor estratégico de negocios" styleClass="page-title"/>
            <Label styleClass="page-subtitle" wrapText="true"
                   text="Motor de reglas local que analiza ventas, inventario, márgenes y tendencias para proponer acciones concretas con su justificación."/>
        </VBox>
        <Button text="Analizar y generar recomendaciones" styleClass="primary" onAction="#generate"/>
    </HBox>
    <FlowPane fx:id="kpiPane" hgap="14" vgap="14"/>
    <HBox styleClass="toolbar-row">
        <ComboBox fx:id="typeFilter" prefWidth="240"/>
        <ComboBox fx:id="priorityFilter" prefWidth="170"/>
        <ComboBox fx:id="stateFilter" prefWidth="170"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS">
        <TableView fx:id="recTable"/>
        <VBox styleClass="card">
            <HBox styleClass="toolbar-row">
                <Label fx:id="detailTitle" styleClass="card-title" text="Seleccione una recomendación"
                       wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="applyButton" text="Aplicar" styleClass="primary" onAction="#apply"/>
                <Button fx:id="discardButton" text="Descartar" onAction="#discard"/>
            </HBox>
            <GridPane fx:id="detailGrid" hgap="14" vgap="8"/>
        </VBox>
    </SplitPane>
</VBox>
