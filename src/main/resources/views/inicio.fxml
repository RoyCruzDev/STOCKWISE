<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockwise.controller.InicioController" fitToWidth="true" styleClass="scroll-page">
    <VBox styleClass="page" spacing="18">
        <VBox spacing="4">
            <Label fx:id="titleLabel" styleClass="hero-title"/>
            <Label fx:id="subtitleLabel" styleClass="hero-subtitle" wrapText="true"/>
        </VBox>
        <VBox fx:id="noticeBox" spacing="6"/>
        <HBox fx:id="stepsBox" spacing="16"/>
        <VBox fx:id="decisionesBox" styleClass="card" spacing="8" visible="false" managed="false"/>
        <FlowPane fx:id="kpiPane" hgap="14" vgap="14"/>
        <VBox styleClass="card" spacing="8">
            <Label text="Últimas importaciones" styleClass="card-title"/>
            <TableView fx:id="importsTable" prefHeight="210"/>
        </VBox>
    </VBox>
</ScrollPane>
