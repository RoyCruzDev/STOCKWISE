<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockwise.controller.ImportController"
            fitToWidth="true" styleClass="scroll-page">
    <VBox styleClass="page">
        <VBox>
            <Label text="Importación de datos desde Excel o CSV (reportes ERP)" styleClass="page-title"/>
            <Label styleClass="page-subtitle"
                   wrapText="true" text="Lea un archivo .xlsx, .xls o .csv de cualquier tamaño (se lee por flujo, sin cargarlo completo en memoria; separador y codificación automáticos), relacione sus columnas con los campos del sistema (la relación se recuerda por formato de reporte), revise la validación y guarde la información. Los archivos grandes se importan por bloques con avance real y pueden cancelarse."/>
        </VBox>

        <VBox styleClass="card">
            <Label text="1. Seleccione el archivo" styleClass="card-title"/>
            <FlowPane hgap="8" vgap="8">
                <Button text="Seleccionar archivo" styleClass="primary" onAction="#selectFile"/>
                <Button text="Descargar plantilla oficial" onAction="#saveTemplate"/>
                <Button text="Generar archivo de demostración" onAction="#saveDemo"/>
            </FlowPane>
            <Label fx:id="fileLabel" styleClass="muted" text="Ningún archivo seleccionado."/>
            <Label styleClass="notice" maxWidth="Infinity"
                   text="Orden recomendado: Sucursales → Productos → Inventario → Ventas históricas → Presupuestos. Las ventas e inventarios hacen referencia a productos y sucursales por su código, por lo que estos deben existir antes."/>
        </VBox>

        <VBox fx:id="progressCard" styleClass="card" visible="false" managed="false">
            <HBox styleClass="toolbar-row">
                <Label fx:id="progressTitle" styleClass="card-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label fx:id="progressPercent" styleClass="big-number"/>
                <Button fx:id="cancelButton" text="Cancelar" styleClass="danger" onAction="#cancelTask"/>
            </HBox>
            <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" prefHeight="12"/>
            <Label fx:id="progressDetail" styleClass="muted" wrapText="true"/>
        </VBox>

        <VBox fx:id="mappingCard" styleClass="card" disable="true">
            <Label text="2. Hoja, tipo de información y relación de columnas" styleClass="card-title"/>
            <HBox styleClass="toolbar-row">
                <Label text="Hoja" styleClass="form-label" minWidth="-Infinity"/>
                <ComboBox fx:id="sheetCombo" prefWidth="240"/>
                <Label text="Tipo de información" styleClass="form-label" minWidth="-Infinity"/>
                <ComboBox fx:id="typeCombo" prefWidth="220"/>
                <Label fx:id="sheetInfo" styleClass="muted" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <Label text="Relacione cada campo del sistema con una columna del Excel (* obligatorio). Los encabezados reconocidos se relacionan automáticamente."
                   styleClass="muted" wrapText="true"/>
            <HBox styleClass="toolbar-row" spacing="8">
                <Label text="Plantilla" styleClass="form-label" minWidth="-Infinity"/>
                <ComboBox fx:id="templateCombo" prefWidth="300"/>
                <Button text="Guardar como plantilla…" onAction="#saveMappingTemplate" minWidth="-Infinity"/>
            </HBox>
            <GridPane fx:id="mappingGrid" hgap="14" vgap="8"/>
            <CheckBox fx:id="separateLinesCheck" wrapText="true"
                      text="Registrar como ventas distintas las líneas idénticas de un mismo comprobante (dos ítems iguales en una boleta). Si no, se omiten como repetidas."/>
            <HBox styleClass="toolbar-row">
                <Button text="Validar y previsualizar" styleClass="primary" onAction="#validate"/>
                <Button text="Importar todas las hojas reconocidas" onAction="#importAll"/>
            </HBox>
        </VBox>

        <VBox fx:id="previewCard" styleClass="card" disable="true">
            <Label text="3. Vista previa y validación" styleClass="card-title"/>
            <HBox styleClass="toolbar-row">
                <Label fx:id="newLabel" styleClass="badge, badge-success" text="0 nuevos"/>
                <Label fx:id="updateLabel" styleClass="badge, badge-info" text="0 actualizaciones"/>
                <Label fx:id="duplicateLabel" styleClass="badge, badge-warning" text="0 duplicados"/>
                <Label fx:id="errorLabel" styleClass="badge, badge-danger" text="0 con error"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Mostrar" styleClass="form-label"/>
                <ComboBox fx:id="filterCombo" prefWidth="170"/>
                <Button text="Exportar observaciones" onAction="#exportIssues"/>
                <Button fx:id="importButton" text="Importar" styleClass="primary" onAction="#importPreview"/>
            </HBox>
            <TableView fx:id="previewTable" prefHeight="420"/>
        </VBox>
    </VBox>
</ScrollPane>
