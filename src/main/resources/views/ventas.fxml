<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stockwise.controller.VentasController" styleClass="page">
    <VBox styleClass="card">
        <HBox styleClass="toolbar-row">
            <Label text="Desde" styleClass="form-label"/>
            <DatePicker fx:id="fromDate" prefWidth="140"/>
            <Label text="Hasta" styleClass="form-label"/>
            <DatePicker fx:id="toDate" prefWidth="140"/>
            <ComboBox fx:id="branchFilter" prefWidth="200"/>
            <ComboBox fx:id="productFilter" prefWidth="260"/>
            <Button text="Buscar" styleClass="primary" onAction="#search"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Registrar venta" onAction="#register"/>
            <Button fx:id="deleteButton" text="Eliminar venta" styleClass="danger" onAction="#delete"/>
        </HBox>
    </VBox>
    <FlowPane fx:id="kpiPane" hgap="14" vgap="14"/>
    <TableView fx:id="salesTable" VBox.vgrow="ALWAYS"/>
    <Label fx:id="limitLabel" styleClass="muted"/>
</VBox>
