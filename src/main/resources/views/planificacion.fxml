<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stockwise.controller.PlanificacionController" styleClass="page">
    <HBox styleClass="toolbar-row">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Planificación avanzada de inventario" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"
                   text="Decisiones por producto, patrones de demanda (ADI/CV²), stock histórico, simulación what-if, scorecard, ROI y backtesting. Todo se calcula localmente."/>
        </VBox>
        <Button text="Recalcular" styleClass="primary" onAction="#refresh"/>
    </HBox>
    <VBox fx:id="notesBox" spacing="6"/>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"/>
</VBox>
