<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockwise.controller.ConfigController" fitToWidth="true" styleClass="scroll-page">
    <VBox styleClass="page">
        <HBox styleClass="toolbar-row">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Configuración del sistema" styleClass="page-title"/>
                <Label text="Los cambios se aplican a los análisis, predicciones y recomendaciones al guardar."
                       styleClass="page-subtitle"/>
            </VBox>
            <Button text="Restablecer valores" onAction="#restoreDefaults"/>
            <Button fx:id="saveButton" text="Guardar cambios" styleClass="primary" onAction="#save"/>
        </HBox>

        <HBox spacing="16">
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="Empresa y moneda" styleClass="card-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="200"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nombre de la empresa *" styleClass="form-label" GridPane.rowIndex="0"/>
                    <TextField fx:id="companyField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Código de moneda" styleClass="form-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="currencyCodeField" promptText="PEN, USD, EUR…" GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>
                    <Label text="Símbolo de moneda *" styleClass="form-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="currencySymbolField" promptText="S/, $, €…" GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>
                    <Label text="Presupuesto general mensual" styleClass="form-label" GridPane.rowIndex="3"/>
                    <TextField fx:id="budgetField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Margen mínimo aceptable (%)" styleClass="form-label" GridPane.rowIndex="4"/>
                    <TextField fx:id="marginField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="Tema visual" styleClass="form-label" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="themeCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
                <Label styleClass="muted" wrapText="true"
                       text="El presupuesto general se usa cuando no existe un presupuesto registrado para el mes en curso (módulo Compras)."/>
            </VBox>
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="Parámetros de predicción" styleClass="card-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="230"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Ventana promedio móvil (meses)" styleClass="form-label" GridPane.rowIndex="0"/>
                    <TextField fx:id="maWindowField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Ventana promedio ponderado (meses)" styleClass="form-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="wmaWindowField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Alfa suavizamiento exponencial" styleClass="form-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="alphaField" promptText="0.01 - 0.99" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Meses mínimos para predicción confiable" styleClass="form-label" GridPane.rowIndex="3"/>
                    <TextField fx:id="minMonthsField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Comprar para cubrir (meses de venta)" styleClass="form-label" GridPane.rowIndex="4"/>
                    <TextField fx:id="horizonField" promptText="1 - 6" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
                <Label styleClass="muted" wrapText="true"
                       text="Con menos de 3 meses de historial no se genera ninguna predicción. Bajo el mínimo confiable se muestran advertencias."/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="Parámetros de inventario" styleClass="card-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="230"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Stock mínimo por defecto" styleClass="form-label" GridPane.rowIndex="0"/>
                    <TextField fx:id="minStockField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Tiempo de reposición por defecto (días)" styleClass="form-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="leadTimeField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Nivel de servicio (%)" styleClass="form-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="serviceLevelField" promptText="50 - 99.9" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Exceso de stock a partir de (meses de venta)" styleClass="form-label" GridPane.rowIndex="3"/>
                    <TextField fx:id="overstockField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Días sin ventas = sin movimiento" styleClass="form-label" GridPane.rowIndex="4"/>
                    <TextField fx:id="noMovementField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
                <Label styleClass="muted" wrapText="true"
                       text="Los valores por defecto se aplican a productos que no tienen stock mínimo o tiempo de reposición propios. El nivel de servicio determina el stock de seguridad."/>
            </VBox>
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="Copias de seguridad" styleClass="card-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="160"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Carpeta de copias" styleClass="form-label" GridPane.rowIndex="0"/>
                    <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="backupDirField" HBox.hgrow="ALWAYS"/>
                        <Button text="…" onAction="#chooseBackupDir"/>
                    </HBox>
                    <Label text="Base de datos" styleClass="form-label" GridPane.rowIndex="1"/>
                    <Label fx:id="dbPathLabel" wrapText="true" styleClass="muted" GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>
                </GridPane>
                <HBox styleClass="toolbar-row">
                    <Button text="Crear copia de seguridad" styleClass="primary" onAction="#backup"/>
                    <Button text="Restaurar desde copia…" styleClass="danger" onAction="#restore"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="backupStatus" styleClass="muted" wrapText="true"/>
                <Label styleClass="notice" wrapText="true" maxWidth="Infinity"
                       text="Antes de restaurar, STOCKWISE guarda automáticamente una copia del estado actual en la subcarpeta 'antes-de-restaurar'."/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
