<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockwise.controller.MainController"
            prefWidth="1366" prefHeight="840">
    <left>
        <VBox styleClass="sidebar">
            <HBox styleClass="brand">
                <VBox spacing="1">
                    <Label text="STOCKWISE" styleClass="brand-name"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="navBox" styleClass="nav-container"/>
            </ScrollPane>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar">
                    <Label fx:id="titleLabel" styleClass="topbar-title" text="Panel principal"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="projectLabel" styleClass="topbar-project"/>
                    <Button fx:id="switchButton" onAction="#switchProject" styleClass="flat" text="Cambiar proyecto"/>
                    <Label fx:id="companyLabel" styleClass="topbar-company"/>
                    <Button fx:id="themeButton" onAction="#toggleTheme" styleClass="flat" text="Modo oscuro"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentPane" styleClass="content"/>
            </center>
            <bottom>
                <HBox styleClass="statusbar">
                    <Label fx:id="statusLabel" text="Listo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dbLabel"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
