<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.stockwise.controller.AccionesController">
    <VBox fx:id="contentBox" styleClass="page" spacing="10">
        <HBox styleClass="toolbar-row" spacing="10">
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Acciones recomendadas" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true" minHeight="-Infinity"
                       text="Ayudas para decidir: tú tomas la decisión final. STOCKWISE no cambia precios, inventario ni compras por su cuenta."/>
            </VBox>
            <TextField fx:id="searchField" promptText="Buscar producto…" prefWidth="220"/>
            <ComboBox fx:id="estadoCombo" prefWidth="150"/>
        </HBox>
        <FlowPane fx:id="tiposPane" hgap="8" vgap="8"/>
        <ListView fx:id="accionesList" VBox.vgrow="ALWAYS" styleClass="acciones-list"/>
    </VBox>
    <VBox fx:id="emptyBox" styleClass="empty-state" visible="false" managed="false">
        <Label text="Todavía no hay acciones recomendadas" styleClass="empty-title"/>
        <Label styleClass="muted" wrapText="true" maxWidth="520"
               text="Importe sus ventas y pulse Analizar. STOCKWISE revisará cada producto y le sugerirá qué comprar, qué dejar de comprar y cómo mejorar sus ventas."/>
        <HBox spacing="10" alignment="CENTER">
            <Button text="Importar datos" onAction="#importData"/>
            <Button text="Analizar ahora" styleClass="primary" onAction="#analyze"/>
        </HBox>
    </VBox>
</StackPane>
