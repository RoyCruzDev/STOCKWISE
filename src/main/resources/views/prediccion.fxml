<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.stockwise.controller.PrediccionController" dividerPositions="0.24"
           styleClass="page">
    <VBox styleClass="card" minWidth="250" maxWidth="380">
        <Label text="Serie a analizar" styleClass="card-title"/>
        <TextField fx:id="searchField" promptText="Buscar producto…"/>
        <ListView fx:id="itemList" VBox.vgrow="ALWAYS"/>
    </VBox>
    <ScrollPane fitToWidth="true" styleClass="scroll-page">
        <VBox spacing="14">
            <HBox styleClass="toolbar-row">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" styleClass="page-title" text="Seleccione un producto"/>
                    <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"/>
                </VBox>
                <Label text="Horizonte" styleClass="form-label"/>
                <ComboBox fx:id="horizonCombo" prefWidth="120"/>
                <Button fx:id="saveButton" text="Guardar predicción" styleClass="primary" onAction="#save"/>
            </HBox>
            <FlowPane fx:id="kpiPane" hgap="12" vgap="12"/>
            <VBox fx:id="warningsBox" spacing="6"/>
            <VBox styleClass="card">
                <Label text="Ventas reales vs. predicciones" styleClass="card-title"/>
                <HBox styleClass="toolbar-row">
                    <Label text="Mostrar métodos:" styleClass="form-label" minWidth="110"/>
                    <FlowPane fx:id="methodChecks" hgap="14" vgap="4" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label styleClass="card-subtitle"
                       text="Las líneas de cada método muestran su pronóstico un paso adelante sobre el historial (validación walk-forward) y su proyección futura."/>
                <LineChart fx:id="chart" animated="false" prefHeight="340" createSymbols="true">
                    <xAxis>
                        <CategoryAxis/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis forceZeroInRange="true"/>
                    </yAxis>
                </LineChart>
            </VBox>
            <HBox spacing="14">
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="Comparación de métodos" styleClass="card-title"/>
                    <Label styleClass="card-subtitle"
                           text="MAE: error absoluto medio (unidades). MAPE: error porcentual medio (solo meses con ventas). Se selecciona el método de menor MAE."/>
                    <TableView fx:id="methodTable" prefHeight="200"/>
                </VBox>
                <VBox styleClass="card" prefWidth="320">
                    <Label text="Pronóstico del método seleccionado" styleClass="card-title"/>
                    <TableView fx:id="forecastTable" prefHeight="200"/>
                    <Label fx:id="savedLabel" styleClass="muted" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</SplitPane>
